{
  "expo": {
    "name": "Lyrpay",
    "slug": "lyrpay-mobile",
    "version": "0.3.0",
    "sdkVersion": "50.0.0",
    "platforms": [
      "ios",
      "android"
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "extra": {},
    "ios": {
      "bundleIdentifier": "com.lyrpay.app",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.lyrpay.app"
    },
    "plugins": [
      "expo-secure-store"
    ]
  }
}
